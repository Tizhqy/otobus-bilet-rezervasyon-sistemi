@model IEnumerable<TicketResponseDto>
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Biletlerim</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="h4 mb-0">Biletlerim</h1>
		<a asp-controller="Sefer" asp-action="Index" class="btn btn-ghost">Yeni Sefer Ara</a>
	</div>

	@if (TempData["Basari"] is string success)
	{
		<div class="alert alert-success">@success</div>
	}
	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	@if (!Model.Any())
	{
		<div class="card-HamsiBus">
			<div class="card-body p-4">
				<p class="mb-0">Henuz biletiniz bulunmuyor.</p>
			</div>
		</div>
	}
	else
	{
		<div class="row g-3">
			@foreach (var t in Model)
			{
				<div class="col-12">
					<div class="card-HamsiBus">
						<div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
							<div>
								<div class="fw-700">#@t.Id - @t.Departure.OriginStation -> @t.Departure.DestinationStation</div>
								<div class="text-muted">Kalkis: @t.Departure.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
								<div class="text-muted">Durum: @t.Status</div>
							</div>
							<div class="text-end">
								<div class="fw-700 mb-2">@t.TotalPrice.ToString("0.00") TL</div>
								<a asp-controller="Bilet" asp-action="Detay" asp-route-id="@t.Id" class="btn btn-primary-HamsiBus">Detay</a>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>
</body>
</html>
