@model IEnumerable<OtobusBiletRezervasyon.DTOs.Ticket.TicketResponseDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Biletlerim";
    var biletler = Model.ToList();
    var upcomingCount = biletler.Count(b => b.Departure.DepartureTime > DateTime.UtcNow && !b.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase));
}

<section style="background:var(--primary);padding:2rem 0;color:#fff;">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="fw-800 mb-1" style="color:#fff;">My Trips</h2>
                <p class="mb-0" style="opacity:0.7;">Manage your bookings</p>
            </div>
            <a asp-controller="Sefer" asp-action="Index" class="btn btn-primary-HamsiBus">
                <i data-lucide="search" style="width:18px;height:18px;"></i>
                Book a New Trip
            </a>
        </div>
    </div>
</section>

<div class="container" style="margin-top:-1.5rem;position:relative;z-index:10;">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--primary-bg);color:var(--primary);">
                    <i data-lucide="ticket" style="width:24px;height:24px;"></i>
                </div>
                <div>
                    <div class="stat-value">@upcomingCount</div>
                    <div class="stat-label">Upcoming Trips</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--success-bg);color:var(--success);">
                    <i data-lucide="map" style="width:24px;height:24px;"></i>
                </div>
                <div>
                    <div class="stat-value">@biletler.Count</div>
                    <div class="stat-label">Total Trips</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(230,126,34,0.1);color:var(--accent);">
                    <i data-lucide="wallet" style="width:24px;height:24px;"></i>
                </div>
                <div>
                    <div class="stat-value">$@biletler.Where(b => b.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || b.Status.Equals("ONAYLANDI", StringComparison.OrdinalIgnoreCase)).Sum(b => b.TotalPrice).ToString("0.00")</div>
                    <div class="stat-label">Total Spent</div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="pb-5">
    <div class="container">
        @if (!biletler.Any())
        {
            <div class="empty-state card-HamsiBus">
                <div class="empty-icon">
                    <i data-lucide="ticket-x" style="width:32px;height:32px;"></i>
                </div>
                <h5>No tickets yet</h5>
                <p>You can book your first trip from the home page.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var bilet in biletler)
                {
                    var statusClass = bilet.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                        ? "status-cancelled"
                        : bilet.Departure.DepartureTime > DateTime.UtcNow ? "status-upcoming" : "status-completed";

                    <div class="trip-card fade-in">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:48px;height:48px;background:var(--primary-bg);border-radius:12px;display:flex;align-items:center;justify-content:center;">
                                    <i data-lucide="bus" style="width:24px;height:24px;color:var(--primary);"></i>
                                </div>
                                <div>
                                    <div style="font-weight:700;color:var(--text-dark);">@bilet.Departure.OriginCity to @bilet.Departure.DestinationCity</div>
                                    <div style="font-size:0.85rem;color:var(--text-muted);">Seat(s): @string.Join(", ", bilet.Passengers.Select(p => p.SeatNumber))</div>
                                </div>
                            </div>
                            <span class="trip-status @statusClass">
                                <i data-lucide="clock" style="width:12px;height:12px;"></i>
                                @bilet.Status
                            </span>
                        </div>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center gap-4">
                                    <div>
                                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;">Date</div>
                                        <div style="font-weight:600;color:var(--text-dark);">@bilet.Departure.DepartureTime.ToString("dd MMM yyyy")</div>
                                    </div>
                                    <div>
                                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;">Departure</div>
                                        <div style="font-weight:600;color:var(--text-dark);">@bilet.Departure.DepartureTime.ToString("HH:mm")</div>
                                    </div>
                                    <div>
                                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;">Arrival</div>
                                        <div style="font-weight:600;color:var(--text-dark);">@bilet.Departure.ArrivalTime.ToString("HH:mm")</div>
                                    </div>
                                    <div>
                                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;">Booking ID</div>
                                        <div style="font-weight:600;color:var(--primary);">BG-@bilet.Id</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <div class="d-flex gap-2 justify-content-md-end">
                                    <a asp-controller="Bilet" asp-action="Indir" asp-route-id="@bilet.Id" class="btn btn-outline-primary btn-sm">
                                        <i data-lucide="download" style="width:14px;height:14px;"></i>
                                    </a>
                                    <a asp-controller="Bilet" asp-action="Detay" asp-route-id="@bilet.Id" class="btn btn-outline-HamsiBus btn-sm">
                                        <i data-lucide="eye" style="width:14px;height:14px;"></i>
                                        Detail
                                    </a>
                                    @if (!bilet.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                                    {
                                        var timeUntilDeparture = (bilet.Departure.DepartureTime - DateTime.UtcNow).TotalMinutes;
                                        if (timeUntilDeparture > OtobusBiletRezervasyon.AppConfig.MinCancellationMinutesBeforeDeparture)
                                        {
                                            <form asp-controller="Bilet" asp-action="Iptal" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@bilet.Id" />
                                                <button type="submit" class="btn btn-sm" style="border:1px solid var(--danger);color:var(--danger);border-radius:var(--radius);font-weight:600;" onclick="return confirm('Are you sure you want to cancel this ticket? An administrative fee may apply.');">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else if (bilet.Departure.DepartureTime >= DateTime.UtcNow)
                                        {
                                            <span style="font-size:0.8rem;color:var(--text-muted);border:1px solid #e2e8f0;padding:4px 8px;border-radius:4px;cursor:help;" 
                                                  title="Ticket cancellations are locked by the system @OtobusBiletRezervasyon.AppConfig.MinCancellationMinutesBeforeDeparture minutes before departure.">
                                              <i data-lucide="lock" style="width:12px;height:12px;"></i> Locked
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

