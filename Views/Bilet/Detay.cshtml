@model TicketResponseDto
@{
	Layout = null;
	var isPending = Model.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ||
	                Model.Status.Equals("BEKLEMEDE", StringComparison.OrdinalIgnoreCase);
	var isPaid = Model.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase) ||
	             Model.Status.Equals("Odendi", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Bilet Detayi</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4" style="max-width:820px;">
	<h1 class="h4 mb-4">Bilet Detayi</h1>

	@if (TempData["Basari"] is string success)
	{
		<div class="alert alert-success">@success</div>
	}
	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	<div class="card-HamsiBus mb-4">
		<div class="card-body p-4">
			<div class="d-flex justify-content-between align-items-center">
				<div class="fw-700">Bilet #@Model.Id</div>
				<span class="badge text-bg-secondary">@Model.Status</span>
			</div>
			<div class="mt-3">
				<div>@Model.Departure.OriginStation (@Model.Departure.OriginCity) -> @Model.Departure.DestinationStation (@Model.Departure.DestinationCity)</div>
				<div class="text-muted">Kalkis: @Model.Departure.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
				<div class="text-muted">Varis: @Model.Departure.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</div>
				<div class="text-muted">Otobus: @Model.Departure.BusPlateNumber</div>
				<div class="fw-700 mt-2">Toplam: @Model.TotalPrice.ToString("0.00") TL</div>
			</div>
		</div>
	</div>

	<div class="card-HamsiBus mb-4">
		<div class="card-body p-4">
			<h2 class="h6 mb-3">Yolcular</h2>
			<ul class="list-group">
				@foreach (var p in Model.Passengers)
				{
					<li class="list-group-item d-flex justify-content-between">
						<span>@p.FirstName @p.LastName</span>
						<span>Koltuk: @p.SeatNumber</span>
					</li>
				}
			</ul>
		</div>
	</div>

	<div class="d-flex gap-2">
		@if (isPending)
		{
			<a asp-controller="Odeme" asp-action="Odeme" asp-route-biletId="@Model.Id" class="btn btn-primary-HamsiBus">Odemeye Git</a>
		}
		@if (isPaid)
		{
			<button class="btn btn-success" type="button" disabled>Odeme Tamamlandi</button>
		}
		<a asp-controller="Bilet" asp-action="Liste" class="btn btn-ghost">Biletlerim</a>
	</div>
</div>
</body>
</html>
