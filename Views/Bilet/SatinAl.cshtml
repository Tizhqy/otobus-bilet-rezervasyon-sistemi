@{
	Layout = null;
	var departure = ViewBag.Sefer as DepartureResponseDto;
	var selectedSeat = ViewBag.SecilenKoltuk as SeatInfoDto;
	int seferId = ViewBag.SeferId ?? 0;
	int koltukId = ViewBag.KoltukId ?? 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Bilet Satin Al</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4" style="max-width:760px;">
	<h1 class="h4 mb-4">Bilet Satin Al</h1>

	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	@if (departure != null && selectedSeat != null)
	{
		<div class="card-HamsiBus mb-4">
			<div class="card-body p-4">
				<div class="fw-700">@departure.Route.OriginStation.Name -> @departure.Route.DestinationStation.Name</div>
				<div class="text-muted">Kalkis: @departure.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
				<div class="text-muted">Koltuk: @selectedSeat.SeatNumber</div>
				<div class="fw-700 mt-2">Toplam: @departure.Price.ToString("0.00") TL</div>
			</div>
		</div>

		<div class="card-HamsiBus">
			<div class="card-body p-4">
				<form asp-controller="Bilet" asp-action="SatinAlForm" method="post">
					<input type="hidden" name="seferId" value="@seferId" />
					<input type="hidden" name="koltukId" value="@koltukId" />

					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label">Yolcu Ad</label>
							<input name="yolcuAd" class="form-control" required />
						</div>
						<div class="col-md-6">
							<label class="form-label">Yolcu Soyad</label>
							<input name="yolcuSoyad" class="form-control" required />
						</div>
						<div class="col-md-6">
							<label class="form-label">TC (opsiyonel)</label>
							<input name="yolcuTc" class="form-control" maxlength="11" />
						</div>
						<div class="col-md-6">
							<label class="form-label">Odeme Yontemi</label>
							<select name="odemeYontemi" class="form-select">
								<option value="credit_card">Kredi Karti</option>
								<option value="debit_card">Banka Karti</option>
								<option value="paypal">PayPal</option>
							</select>
						</div>
					</div>

					<div class="d-flex gap-2 mt-4">
						<button type="submit" class="btn btn-primary-HamsiBus">Devam Et (Odeme)</button>
						<a asp-controller="Sefer" asp-action="Detay" asp-route-id="@seferId" class="btn btn-ghost">Iptal</a>
					</div>
				</form>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-warning">Sefer veya koltuk bilgisi bulunamadi.</div>
		<a asp-controller="Sefer" asp-action="Index" class="btn btn-primary-HamsiBus">Ana Sayfaya Don</a>
	}
</div>
</body>
</html>
