@using System.Linq
@using System.Text.Json
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var basariMesaji = TempData["Basari"] as string;
    var hataMesaji = TempData["Hata"] as string;
    var bilgiMesaji = TempData["Bilgi"] as string;
    var modelHataMesajlari = ViewData.ModelState
        .Where(ms => string.IsNullOrWhiteSpace(ms.Key))
        .SelectMany(ms => ms.Value?.Errors.Select(err => err.ErrorMessage) ?? Enumerable.Empty<string>())
        .Where(msg => !string.IsNullOrWhiteSpace(msg))
        .Distinct()
        .ToList();
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HamsiBus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.css")" rel="stylesheet" />
    @RenderSection("Head", required: false)
</head>
<body>
    <div id="toastContainer" class="toast-container position-fixed p-3 hamsibus-toast-container"></div>

    <nav class="navbar navbar-expand-lg navbar-HamsiBus">
        <div class="container">
            <a class="navbar-brand" asp-controller="Sefer" asp-action="Index">
                <i data-lucide="bus" style="width:28px;height:28px;"></i>
                HamsiBus
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <i data-lucide="menu" style="width:24px;height:24px;"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto ms-4">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Sefer" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Sefer"
                           asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Sefer" && currentAction == "AramaSonuclari" ? "active" : "")"
                           asp-controller="Sefer"
                           asp-action="AramaSonuclari">Routes</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Bilet" && currentAction == "Liste" ? "active" : "")"
                               asp-controller="Bilet"
                               asp-action="Liste">My Trips</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">Admin</a>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-ghost" id="darkModeToggle" aria-label="Toggle dark mode" style="padding: 0.5rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                        <i data-lucide="moon" style="width:20px;height:20px;" id="darkModeIcon"></i>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Auth" asp-action="Profil" style="font-weight:600;font-size:0.9rem;color:var(--text-dark);text-decoration:none;" class="me-2">@User.Identity?.Name</a>
                        <form asp-controller="Auth" asp-action="Cikis" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Giris" class="btn btn-ghost">Login</a>
                        <a asp-controller="Auth" asp-action="Kayit" class="btn btn-primary-HamsiBus">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-HamsiBus mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i data-lucide="bus" style="width:24px;height:24px;color:var(--accent);"></i>
                        <span style="font-weight:800;font-size:1.25rem;color:#fff;">HamsiBus</span>
                    </div>
                    <p style="font-size:0.9rem;max-width:300px;">The smartest way to book bus tickets online. Compare routes, pick your seat, and travel with confidence.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Company</h6>
                    <a asp-controller="Pages" asp-action="About">About Us</a>
                    <a asp-controller="Pages" asp-action="Careers">Careers</a>
                    <a asp-controller="Pages" asp-action="Press">Press Room</a>
                    <a asp-controller="Pages" asp-action="Blog">Blog</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Support</h6>
                    <a asp-controller="Pages" asp-action="HelpCenter">Help Center</a>
                    <a asp-controller="Pages" asp-action="Contact">Contact Us</a>
                    <a asp-controller="Pages" asp-action="RefundPolicy">Refund Policy</a>
                    <a asp-controller="Pages" asp-action="Faq">FAQs</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Legal</h6>
                    <a asp-controller="Pages" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Pages" asp-action="Terms">Terms of Use</a>
                    <a asp-controller="Pages" asp-action="CookiePolicy">Cookie Policy</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Connect</h6>
                    <a href="#">Twitter</a>
                    <a href="#">Facebook</a>
                    <a href="#">Instagram</a>
                    <a href="#">LinkedIn</a>
                </div>
            </div>
            <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center">
                <p class="mb-0" style="font-size:0.85rem;">&copy; @DateTime.Now.Year HamsiBus. All rights reserved.</p>
                <div class="d-flex gap-3" style="font-size:0.85rem;">
                    <a asp-controller="Pages" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Pages" asp-action="Terms">Terms</a>
                    <a asp-controller="Pages" asp-action="CookiePolicy">Cookies</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="@Url.Content("~/js/main.js")"></script>
    @if (!string.IsNullOrWhiteSpace(basariMesaji) || !string.IsNullOrWhiteSpace(hataMesaji) || !string.IsNullOrWhiteSpace(bilgiMesaji) || modelHataMesajlari.Any())
    {
        <script nonce="@cspNonce">
            document.addEventListener("DOMContentLoaded", function () {
                @if (!string.IsNullOrWhiteSpace(basariMesaji))
                {
                    @:showToast(@Html.Raw(JsonSerializer.Serialize(basariMesaji)), "success");
                }
                @if (!string.IsNullOrWhiteSpace(hataMesaji))
                {
                    @:showToast(@Html.Raw(JsonSerializer.Serialize(hataMesaji)), "danger");
                }
                @if (!string.IsNullOrWhiteSpace(bilgiMesaji))
                {
                    @:showToast(@Html.Raw(JsonSerializer.Serialize(bilgiMesaji)), "info");
                }
                @foreach (var modelHata in modelHataMesajlari)
                {
                    @:showToast(@Html.Raw(JsonSerializer.Serialize(modelHata)), "danger");
                }
            });
        </script>
    }

    <script nonce="@cspNonce">
        document.addEventListener("DOMContentLoaded", function () {
            lucide.createIcons();
            
            const darkModeToggle = document.getElementById("darkModeToggle");
            
            if (localStorage.getItem("theme") === "dark") {
                document.body.classList.add("dark-mode");
                if (darkModeToggle) {
                    darkModeToggle.innerHTML = '<i data-lucide="sun" style="width:20px;height:20px;"></i>';
                    lucide.createIcons();
                }
            }

            if (darkModeToggle) {
                darkModeToggle.addEventListener("click", function() {
                    document.body.classList.toggle("dark-mode");
                    const isDark = document.body.classList.contains("dark-mode");
                    localStorage.setItem("theme", isDark ? "dark" : "light");
                    darkModeToggle.innerHTML = `<i data-lucide="${isDark ? 'sun' : 'moon'}" style="width:20px;height:20px;"></i>`;
                    lucide.createIcons();
                });
            }
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>

