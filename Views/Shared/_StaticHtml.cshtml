@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    var staticHtmlPath = ViewData["StaticHtmlPath"] as string;
    var absolutePath = string.IsNullOrWhiteSpace(staticHtmlPath)
        ? null
        : System.IO.Path.Combine(Env.ContentRootPath, staticHtmlPath);
}

@if (!string.IsNullOrWhiteSpace(absolutePath) && System.IO.File.Exists(absolutePath))
{
    @Html.Raw(System.IO.File.ReadAllText(absolutePath))
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>View not available</h1>
        <p>The requested static view could not be loaded.</p>
    </div>
}