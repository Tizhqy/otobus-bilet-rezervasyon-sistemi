@{
    Layout = "_Layout";
    ViewData["Title"] = "Sifremi Unuttum";
}

<section class="py-5">
    <div class="container" style="max-width:520px;">
        <div class="card-HamsiBus">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div style="width:56px;height:56px;background:var(--primary-bg);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                        <i data-lucide="key-round" style="width:24px;height:24px;color:var(--primary);"></i>
                    </div>
                    <h4 class="fw-700 mb-1">Reset your password</h4>
                    <p class="text-muted mb-0" style="font-size:0.9rem;">Enter your email and we'll send a reset link.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                }

                <form asp-controller="Auth" asp-action="SifremiUnuttum" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                    </div>
                    <button type="submit" class="btn btn-primary-HamsiBus w-100 py-2">Send Reset Link</button>
                </form>

                <a asp-controller="Auth" asp-action="Giris" class="btn btn-ghost w-100 mt-2">Back to login</a>
            </div>
        </div>
    </div>
</section>

