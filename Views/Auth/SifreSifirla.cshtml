@{
    Layout = "_Layout";
    ViewData["Title"] = "Sifre Sifirla";
    var token = ViewBag.Token as string ?? string.Empty;
}

<section class="py-5">
    <div class="container" style="max-width:520px;">
        <div class="card-HamsiBus">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div style="width:56px;height:56px;background:var(--success-bg);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                        <i data-lucide="shield-check" style="width:24px;height:24px;color:var(--success);"></i>
                    </div>
                    <h4 class="fw-700 mb-1">Create new password</h4>
                    <p class="text-muted mb-0" style="font-size:0.9rem;">Use at least 8 characters with upper/lowercase letters and a number.</p>
                </div>

                <form asp-controller="Auth" asp-action="SifreSifirla" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@token" />
                    <div class="mb-3">
                        <label class="form-label">Yeni Sifre</label>
                        <input type="password" name="yeniSifre" class="form-control" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Yeni Sifre Tekrar</label>
                        <input type="password" name="yeniSifreTekrar" class="form-control" minlength="8" required />
                    </div>
                    <button type="submit" class="btn btn-primary-HamsiBus w-100 py-2">Sifreyi Guncelle</button>
                </form>
            </div>
        </div>
    </div>
</section>

