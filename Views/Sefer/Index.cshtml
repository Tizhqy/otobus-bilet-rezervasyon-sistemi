@model SearchQueryDto
@{
	Layout = null;
	var stations = ViewBag.Istasyonlar as IEnumerable<StationInfoDto> ?? Enumerable.Empty<StationInfoDto>();
	var upcoming = ViewBag.YaklasanSeferler as IEnumerable<DepartureResponseDto> ?? Enumerable.Empty<DepartureResponseDto>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Sefer Ara</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="h3 mb-0">Sefer Ara</h1>
		<div class="d-flex gap-2">
			<a asp-controller="Auth" asp-action="Giris" class="btn btn-ghost">Giris</a>
			<a asp-controller="Auth" asp-action="Kayit" class="btn btn-primary-HamsiBus">Kayit Ol</a>
		</div>
	</div>

	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	<div class="card-HamsiBus mb-4">
		<div class="card-body p-4">
			<form asp-controller="Sefer" asp-action="Ara" method="get" class="row g-3">
				<div class="col-md-4">
					<label asp-for="OriginStationId" class="form-label">Kalkis</label>
					<select asp-for="OriginStationId" class="form-select">
						<option value="">Istasyon secin</option>
						@foreach (var station in stations)
						{
							<option value="@station.Id">@station.Name (@station.City)</option>
						}
					</select>
				</div>
				<div class="col-md-4">
					<label asp-for="DestinationStationId" class="form-label">Varis</label>
					<select asp-for="DestinationStationId" class="form-select">
						<option value="">Istasyon secin</option>
						@foreach (var station in stations)
						{
							<option value="@station.Id">@station.Name (@station.City)</option>
						}
					</select>
				</div>
				<div class="col-md-2">
					<label asp-for="TravelDate" class="form-label">Tarih</label>
					<input asp-for="TravelDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
				</div>
				<div class="col-md-2">
					<label asp-for="PassengerCount" class="form-label">Yolcu</label>
					<input asp-for="PassengerCount" type="number" min="1" max="10" class="form-control" value="1" />
				</div>
				<div class="col-12">
					<button type="submit" class="btn btn-primary-HamsiBus">Seferleri Bul</button>
				</div>
			</form>
		</div>
	</div>

	<h2 class="h5 mb-3">Yaklasan Seferler</h2>
	@await Html.PartialAsync("_YaklasanSeferler", upcoming)
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
