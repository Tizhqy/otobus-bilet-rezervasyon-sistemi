@model DepartureResponseDto
@{
	Layout = null;
	var seats = ViewBag.Koltuklar as IEnumerable<SeatInfoDto> ?? Enumerable.Empty<SeatInfoDto>();
	var availableSeats = seats.Where(s => s.Status.Equals("available", StringComparison.OrdinalIgnoreCase)).ToList();
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Sefer Detayi</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="h4 mb-0">Sefer Detayi</h1>
		<a asp-controller="Sefer" asp-action="Index" class="btn btn-ghost">Geri</a>
	</div>

	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	<div class="card-HamsiBus mb-4">
		<div class="card-body p-4">
			<div class="fw-700 mb-2">@Model.Route.OriginStation.Name (@Model.Route.OriginStation.City) -> @Model.Route.DestinationStation.Name (@Model.Route.DestinationStation.City)</div>
			<div class="text-muted mb-1">Kalkis: @Model.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
			<div class="text-muted mb-1">Varis: @Model.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</div>
			<div class="text-muted mb-1">Otobus: @Model.Bus.PlateNumber (@Model.Bus.Type)</div>
			<div class="fw-700 mt-2">Fiyat: @Model.Price.ToString("0.00") TL</div>
		</div>
	</div>

	<h2 class="h5 mb-3">Musait Koltuklar</h2>
	@if (!availableSeats.Any())
	{
		<div class="alert alert-warning">Bu seferde musait koltuk kalmadi.</div>
	}
	else
	{
		<div class="d-flex flex-wrap gap-2">
			@foreach (var seat in availableSeats)
			{
				<a asp-controller="Bilet"
				   asp-action="SatinAl"
				   asp-route-seferId="@Model.Id"
				   asp-route-koltukId="@seat.Id"
				   class="btn btn-outline-success">
					@seat.SeatNumber
				</a>
			}
		</div>
	}
</div>
</body>
</html>
