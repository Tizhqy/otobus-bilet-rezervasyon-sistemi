@model IEnumerable<OtobusBiletRezervasyon.DTOs.Search.SeatInfoDto>

<div class="d-flex flex-wrap justify-content-center gap-2">
    @foreach (var seat in Model.OrderBy(s => s.SeatNumber))
    {
        var available = seat.Status.Equals("Available", StringComparison.OrdinalIgnoreCase);
        <div class="seat @(available ? "" : "taken")" data-seat="@seat.SeatNumber" data-seat-id="@seat.Id">
            @seat.SeatNumber
        </div>
    }
</div>

