@model OtobusBiletRezervasyon.DTOs.ViewModels.SeferDetayViewModel

<div class="bus-outline @Model.LayoutClass">
    <div class="bus-front">
        <i data-lucide="circle-dot" style="width:14px;height:14px;display:inline;vertical-align:-2px;"></i>
        Driver
    </div>
    <div class="bus-layout-label">@Model.LayoutLabel Layout</div>
    <div class="bus-seats-grid">
        @foreach (var row in Model.SeatRows)
        {
            <div class="seat-row">
                <div class="seat-group seat-group-left">
                    @foreach (var seat in row.LeftSeats)
                    {
                        var available = seat.Status.Equals("Available", StringComparison.OrdinalIgnoreCase);
                        <div class="seat @(available ? "" : "taken")" data-seat="@seat.SeatNumber" data-seat-id="@seat.Id">
                            @seat.SeatNumber
                        </div>
                    }
                </div>
                <span class="aisle" aria-hidden="true"></span>
                <div class="seat-group seat-group-right">
                    @foreach (var seat in row.RightSeats)
                    {
                        var available = seat.Status.Equals("Available", StringComparison.OrdinalIgnoreCase);
                        <div class="seat @(available ? "" : "taken")" data-seat="@seat.SeatNumber" data-seat-id="@seat.Id">
                            @seat.SeatNumber
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
