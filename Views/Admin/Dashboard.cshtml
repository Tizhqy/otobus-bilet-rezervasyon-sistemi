@using System.Globalization
@model OtobusBiletRezervasyon.DTOs.ViewModels.AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
}

<section class="py-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">Admin Dashboard</h3>
                <p class="text-muted mb-0">System overview and management tables</p>
            </div>
            <div>
                <a asp-action="Kuponlar" asp-controller="Admin" class="btn btn-outline-primary">
                    <i data-lucide="tag" style="width:18px;height:18px;"></i> Coupon Management
                </a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background:var(--primary-bg);color:var(--primary);">
                        <i data-lucide="users" style="width:24px;height:24px;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.Stats.TotalUsers</div>
                        <div class="stat-label">Total Users</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background:var(--success-bg);color:var(--success);">
                        <i data-lucide="bus" style="width:24px;height:24px;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.Stats.TotalBuses</div>
                        <div class="stat-label">Total Buses</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(230,126,34,0.1);color:var(--accent);">
                        <i data-lucide="route" style="width:24px;height:24px;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.Stats.TotalRoutes</div>
                        <div class="stat-label">Total Routes</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon" style="background:var(--info-bg);color:var(--info);">
                        <i data-lucide="dollar-sign" style="width:24px;height:24px;"></i>
                    </div>
                    <div>
                        <div class="stat-value">$@Model.Stats.TotalRevenue.ToString("0.00")</div>
                        <div class="stat-label">Total Revenue</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="data-table mb-4">
                    <div class="p-3 pb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-700 mb-1">Live Bus Monitoring</h6>
                            <p class="text-muted mb-0">Follow active vehicles dynamically. (GPS Emulator)</p>
                        </div>
                        <button id="refreshMapBtn" class="btn btn-sm btn-outline-primary">Refresh Data</button>
                    </div>
                    <div class="p-3">
                        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
                        <div id="liveBusMap" style="height: 400px; width: 100%; border-radius: 8px; border: 1px solid #e2e8f0; z-index: 1;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="data-table">
                    <div class="p-3 pb-0">
                        <h6 class="fw-700 mb-1">Departure Price Management</h6>
                        <p class="text-muted mb-0">
                            Update individual prices or apply bulk price updates for active/upcoming departures based on filters.
                        </p>
                    </div>

                    <div class="p-3 border-bottom">
                        <form asp-action="SeferFiyatTopluGuncelle" asp-controller="Admin" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-2">
                                <label class="form-label mb-1">Route</label>
                                <select class="form-select" name="RouteId">
                                    <option value="">All Routes</option>
                                    @foreach (var route in Model.RouteOptions)
                                    {
                                        var origin = !string.IsNullOrWhiteSpace(route.OriginStation?.City)
                                            ? route.OriginStation!.City
                                            : !string.IsNullOrWhiteSpace(route.OriginStation?.Name) ? route.OriginStation!.Name : $"Station #{route.OriginStationId}";
                                        var destination = !string.IsNullOrWhiteSpace(route.DestinationStation?.City)
                                            ? route.DestinationStation!.City
                                            : !string.IsNullOrWhiteSpace(route.DestinationStation?.Name) ? route.DestinationStation!.Name : $"Station #{route.DestinationStationId}";
                                        <option value="@route.Id">@origin &rarr; @destination</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label mb-1">Bus</label>
                                <select class="form-select" name="BusId">
                                    <option value="">All Buses</option>
                                    @foreach (var bus in Model.BusOptions)
                                    {
                                        <option value="@bus.Id">@bus.PlateNumber</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label mb-1">Start Date</label>
                                <input type="date" class="form-control" name="StartDate" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label mb-1">End Date</label>
                                <input type="date" class="form-control" name="EndDate" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label mb-1">Mode</label>
                                <select class="form-select" name="Mode" id="bulkPriceMode">
                                    <option value="Multiply" selected>Multiply</option>
                                    <option value="SetFixed">Set Fixed</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label mb-1">Multiplier / Price</label>
                                <input type="text"
                                       inputmode="decimal"
                                       class="form-control"
                                       id="bulkMultiplier"
                                       name="Multiplier"
                                       value="0,90" />
                                <input type="text"
                                       inputmode="decimal"
                                       class="form-control d-none"
                                       id="bulkFixedPrice"
                                       name="FixedPrice"
                                       placeholder="Fixed price"
                                       disabled />
                            </div>
                            <div class="col-12 d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary-HamsiBus">
                                    Bulk Update Prices
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="p-3 border-bottom d-flex align-items-center gap-2 flex-wrap">
                        <form asp-action="Dashboard" asp-controller="Admin" method="get" class="d-flex gap-2 align-items-center flex-grow-1">
                            <div class="input-group" style="max-width:340px;">
                                <span class="input-group-text"><i data-lucide="search" style="width:16px;height:16px;"></i></span>
                                <input type="text"
                                       class="form-control"
                                       name="depSearch"
                                       placeholder="Search by ID, plate or city..."
                                       value="@Model.DepartureSearchTerm" />
                                @if (!string.IsNullOrWhiteSpace(Model.DepartureSearchTerm))
                                {
                                    <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-outline-secondary">Clear</a>
                                }
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary-HamsiBus">Search</button>
                        </form>
                        <span class="text-muted" style="font-size:0.85rem; white-space:nowrap;">
                            @Model.DeparturesTotalCount departure(s) found &nbsp;·&nbsp;
                            Page @Model.DeparturesCurrentPage of @Model.DeparturesTotalPages
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Departure</th>
                                    <th>Route</th>
                                    <th>Bus</th>
                                    <th>Current Price</th>
                                    <th>New Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.UpcomingDepartures.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            @if (!string.IsNullOrWhiteSpace(Model.DepartureSearchTerm))
                                            {
                                                <span>No departures found for "<strong>@Model.DepartureSearchTerm</strong>".</span>
                                            }
                                            else
                                            {
                                                <span>No active upcoming departures found for price update.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var departure in Model.UpcomingDepartures)
                                    {
                                        var origin = !string.IsNullOrWhiteSpace(departure.Route?.OriginStation?.City)
                                            ? departure.Route.OriginStation.City
                                            : !string.IsNullOrWhiteSpace(departure.Route?.OriginStation?.Name) ? departure.Route.OriginStation.Name : "-";
                                        var destination = !string.IsNullOrWhiteSpace(departure.Route?.DestinationStation?.City)
                                            ? departure.Route.DestinationStation.City
                                            : !string.IsNullOrWhiteSpace(departure.Route?.DestinationStation?.Name) ? departure.Route.DestinationStation.Name : "-";

                                        <tr>
                                            <td>
                                                <div style="font-weight:600;">#@departure.Id</div>
                                                <div class="text-muted" style="font-size:0.85rem;">
                                                    @departure.DepartureTime.ToString("dd.MM.yyyy HH:mm")
                                                </div>
                                            </td>
                                            <td>@origin &rarr; @destination</td>
                                            <td>@(departure.Bus?.PlateNumber ?? $"- ({departure.BusId})")</td>
                                            <td>$@departure.Price.ToString("0.00")</td>
                                            <td>
                                                <form asp-action="SeferFiyatGuncelle"
                                                      asp-controller="Admin"
                                                      method="post"
                                                      class="d-flex align-items-center gap-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="DepartureId" value="@departure.Id" />
                                                    <div class="input-group input-group-sm" style="max-width:170px;">
                                                        <span class="input-group-text">$</span>
                                                        <input type="text"
                                                               inputmode="decimal"
                                                               class="form-control"
                                                               name="NewPrice"
                                                               required
                                                               value="@departure.Price.ToString("0.00", CultureInfo.CurrentCulture)" />
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-primary-HamsiBus">Save</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.DeparturesTotalPages > 1)
                    {
                        <div class="p-3 d-flex justify-content-center">
                            <nav aria-label="Departures pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    @if (Model.DeparturesCurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@(Model.DeparturesCurrentPage - 1)">
                                                &laquo;
                                            </a>
                                        </li>
                                    }

                                    @for (int p = Math.Max(1, Model.DeparturesCurrentPage - 2); p <= Math.Min(Model.DeparturesTotalPages, Model.DeparturesCurrentPage + 2); p++)
                                    {
                                        <li class="page-item @(p == Model.DeparturesCurrentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@p">
                                                @p
                                            </a>
                                        </li>
                                    }

                                    @if (Model.DeparturesCurrentPage < Model.DeparturesTotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@(Model.DeparturesCurrentPage + 1)">
                                                &raquo;
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="data-table">
                    <div class="p-3 pb-0">
                        <h6 class="fw-700 mb-0">Buses</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Plate</th>
                                    <th>Capacity</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bus in Model.Buses)
                                {
                                    <tr>
                                        <td>@bus.PlateNumber</td>
                                        <td>@bus.Capacity</td>
                                        <td>@(string.IsNullOrWhiteSpace(bus.Type) ? "-" : bus.Type)</td>
                                        <td>
                                            <span class="badge-status @(bus.IsActive ? "badge-active" : "badge-inactive")">
                                                @(bus.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.BusesTotalPages > 1)
                    {
                        <div class="p-3 d-flex justify-content-center border-top">
                            <nav aria-label="Buses pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    @if (Model.BusesCurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-routePage="@Model.RoutesCurrentPage"
                                               asp-route-busPage="@(Model.BusesCurrentPage - 1)">
                                                &laquo;
                                            </a>
                                        </li>
                                    }

                                    @for (int p = Math.Max(1, Model.BusesCurrentPage - 2); p <= Math.Min(Model.BusesTotalPages, Model.BusesCurrentPage + 2); p++)
                                    {
                                        <li class="page-item @(p == Model.BusesCurrentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-routePage="@Model.RoutesCurrentPage"
                                               asp-route-busPage="@p">
                                                @p
                                            </a>
                                        </li>
                                    }

                                    @if (Model.BusesCurrentPage < Model.BusesTotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-routePage="@Model.RoutesCurrentPage"
                                               asp-route-busPage="@(Model.BusesCurrentPage + 1)">
                                                &raquo;
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="data-table">
                    <div class="p-3 pb-0">
                        <h6 class="fw-700 mb-0">Routes</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Route</th>
                                    <th>Distance</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var route in Model.Routes)
                                {
                                    var originDisplay = !string.IsNullOrWhiteSpace(route.OriginStation?.City)
                                        ? route.OriginStation.City
                                        : !string.IsNullOrWhiteSpace(route.OriginStation?.Name) ? route.OriginStation.Name : "-";
                                    var destinationDisplay = !string.IsNullOrWhiteSpace(route.DestinationStation?.City)
                                        ? route.DestinationStation.City
                                        : !string.IsNullOrWhiteSpace(route.DestinationStation?.Name) ? route.DestinationStation.Name : "-";
                                    <tr>
                                        <td>@originDisplay &rarr; @destinationDisplay</td>
                                        <td>@(route.DistanceKm?.ToString() ?? "-") km</td>
                                        <td>@(route.DurationMinutes?.ToString() ?? "-") min</td>
                                        <td>
                                            <span class="badge-status @(route.IsActive ? "badge-active" : "badge-inactive")">
                                                @(route.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.RoutesTotalPages > 1)
                    {
                        <div class="p-3 d-flex justify-content-center border-top">
                            <nav aria-label="Routes pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    @if (Model.RoutesCurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-busPage="@Model.BusesCurrentPage"
                                               asp-route-routePage="@(Model.RoutesCurrentPage - 1)">
                                                &laquo;
                                            </a>
                                        </li>
                                    }

                                    @for (int p = Math.Max(1, Model.RoutesCurrentPage - 2); p <= Math.Min(Model.RoutesTotalPages, Model.RoutesCurrentPage + 2); p++)
                                    {
                                        <li class="page-item @(p == Model.RoutesCurrentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-busPage="@Model.BusesCurrentPage"
                                               asp-route-routePage="@p">
                                                @p
                                            </a>
                                        </li>
                                    }

                                    @if (Model.RoutesCurrentPage < Model.RoutesTotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-action="Dashboard" asp-controller="Admin"
                                               asp-route-depSearch="@Model.DepartureSearchTerm"
                                               asp-route-depPage="@Model.DeparturesCurrentPage"
                                               asp-route-busPage="@Model.BusesCurrentPage"
                                               asp-route-routePage="@(Model.RoutesCurrentPage + 1)">
                                                &raquo;
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="data-table">
                    <div class="p-3 pb-0">
                        <h6 class="fw-700 mb-0">Users</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>@user.FirstName @user.LastName</td>
                                        <td>@user.Email</td>
                                        <td>@user.Role?.Name</td>
                                        <td>
                                            <span class="badge-status @(user.IsActive ? "badge-active" : "badge-inactive")">
                                                @(user.IsActive ? "Active" : "Suspended")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="data-table">
                    <div class="p-3 pb-0">
                        <h6 class="fw-700 mb-0">Recent Logs</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Action</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentLogs)
                                {
                                    <tr>
                                        <td>@log.CreatedAt.ToString("dd.MM HH:mm")</td>
                                        <td>@log.Action</td>
                                        <td>@log.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script nonce="@cspNonce">
        document.addEventListener("DOMContentLoaded", function () {
            const modeSelect = document.getElementById("bulkPriceMode");
            const multiplierInput = document.getElementById("bulkMultiplier");
            const fixedPriceInput = document.getElementById("bulkFixedPrice");

            if (!modeSelect || !multiplierInput || !fixedPriceInput) {
                return;
            }

            const syncPriceMode = function () {
                const useMultiplier = modeSelect.value === "Multiply";
                multiplierInput.disabled = !useMultiplier;
                multiplierInput.classList.toggle("d-none", !useMultiplier);
                fixedPriceInput.disabled = useMultiplier;
                fixedPriceInput.classList.toggle("d-none", useMultiplier);
            };

            modeSelect.addEventListener("change", syncPriceMode);
            syncPriceMode();
        });
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script nonce="@cspNonce">
        document.addEventListener("DOMContentLoaded", function () {
            const mapContainer = document.getElementById("liveBusMap");
            if (!mapContainer) return;

            // Initialize Map centered roughly around Turkey
            const map = L.map('liveBusMap').setView([39.0, 35.0], 5);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(map);

            let busMarkers = {};
            const busIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/3448/3448339.png',
                iconSize: [32, 32],
                iconAnchor: [16, 16],
                popupAnchor: [0, -16]
            });

            async function fetchLiveLocations() {
                try {
                    const response = await fetch('@Url.Action("GetLiveBusLocations", "Admin")');
                    if (!response.ok) throw new Error("Failed to load map data");
                    
                    const locations = await response.json();
                    
                    // Clear old markers if they no longer exist
                    const newIds = new Set(locations.map(l => l.id));
                    for (const id in busMarkers) {
                        if (!newIds.has(parseInt(id))) {
                            map.removeLayer(busMarkers[id]);
                            delete busMarkers[id];
                        }
                    }

                    // Update or create markers
                    locations.forEach(bus => {
                        const latLng = [bus.lat, bus.lng];
                        const popupContent = `<b>${bus.plate}</b><br>Speed: ${bus.speed} km/h<br>Status: ${bus.status}`;
                        
                        if (busMarkers[bus.id]) {
                            busMarkers[bus.id].setLatLng(latLng);
                            busMarkers[bus.id].setPopupContent(popupContent);
                        } else {
                            busMarkers[bus.id] = L.marker(latLng, { icon: busIcon }).addTo(map)
                                .bindPopup(popupContent);
                        }
                    });
                } catch (error) {
                    console.error("Map fetch error:", error);
                }
            }

            fetchLiveLocations();
            const btn = document.getElementById('refreshMapBtn');
            if (btn) btn.addEventListener('click', fetchLiveLocations);
            
            // Auto Update every 5 seconds
            setInterval(fetchLiveLocations, 5000);
        });
    </script>
}
