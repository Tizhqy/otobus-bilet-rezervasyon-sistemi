@{
    ViewData["Title"] = "Careers";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Careers</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>Join the HamsiBus Team</h4>
            <p>We are creating digital solutions that break ground in the travel industry. Would you like to take part in our dynamic, creative, and innovative team?</p>
            
            <h5 class="mt-4">Open Positions</h5>
            <ul class="list-group list-group-flush mt-3">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Senior .NET Developer</strong>
                        <div class="text-muted small">Full Time - Remote / Hybrid</div>
                    </div>
                    <button class="btn btn-sm btn-outline-HamsiBus">Apply</button>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>UI/UX Designer</strong>
                        <div class="text-muted small">Full Time - Istanbul Office</div>
                    </div>
                    <button class="btn btn-sm btn-outline-HamsiBus">Apply</button>
                </li>
            </ul>
        </div>
    </div>
</div>
