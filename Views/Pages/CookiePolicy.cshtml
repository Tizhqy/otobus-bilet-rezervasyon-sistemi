@{
    ViewData["Title"] = "Cookie Policy";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Cookie Policy</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>How we use Cookies</h4>
            <p>We use cookies to keep the site working, remember preferences, and improve performance.</p>

            <hr class="my-4" />

            <h5>1) Cookie Types</h5>
            <ul class="mb-3">
                <li>Essential cookies: Required for login and security.</li>
                <li>Functional cookies: Remember settings like language or city.</li>
                <li>Analytics cookies: Help us understand usage and improve performance.</li>
                <li>Marketing cookies: Support relevant content and campaigns.</li>
            </ul>

            <h5>2) Managing Cookies</h5>
            <ul class="mb-3">
                <li>You can block or delete cookies in your browser settings.</li>
                <li>Disabling essential cookies may affect site functionality.</li>
                <li>You can update analytics and marketing preferences at any time.</li>
            </ul>

            <h5>3) Third-Party Cookies</h5>
            <p>We may use third-party services for analytics and payments. Please review their cookie policies for details.</p>
        </div>
    </div>
</div>