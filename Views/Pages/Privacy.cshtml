@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Privacy Policy</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>Your Privacy Matters</h4>
            <p>We take your privacy seriously. This policy explains what data we collect, how we use it, and how we protect it.</p>

            <hr class="my-4" />

            <h5>1) Data We Collect</h5>
            <ul class="mb-3">
                <li>Identity and contact details (name, email, phone).</li>
                <li>Travel details (route, seat, departure and arrival).</li>
                <li>Transaction data (payment status, invoices; full card data is not stored).</li>
                <li>Technical data (IP address, device, browser, logs).</li>
            </ul>

            <h5>2) How We Use Data</h5>
            <ul class="mb-3">
                <li>To complete reservations and issue tickets.</li>
                <li>To send confirmations, updates, and support messages.</li>
                <li>To prevent fraud and improve security.</li>
                <li>To improve service quality and analytics.</li>
            </ul>

            <h5>3) Sharing</h5>
            <p>We share data only with carrier companies, payment providers, and authorities when required by law.</p>

            <h5>4) Retention</h5>
            <p>We keep data for the period required by law or business needs, then delete or anonymize it.</p>

            <h5>5) Your Rights</h5>
            <p>You can request access, correction, or deletion of your data, or object to processing where applicable.</p>

            <h5>6) Security</h5>
            <p>We apply technical and organizational measures such as access control, encryption, and logging.</p>

            <hr class="my-4" />

            <p class="mb-0">Contact: support@hamsibus.com</p>
        </div>
    </div>
</div>