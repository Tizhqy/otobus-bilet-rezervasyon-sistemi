@{
    ViewData["Title"] = "Help Center";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Help Center</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>How can we help you?</h4>
            <p>Browse popular topics or reach out to our support team.</p>

            <div class="row g-3 mt-2">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Booking</h5>
                        <p class="mb-0">Searching routes, selecting seats, and confirming tickets.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Payments</h5>
                        <p class="mb-0">Card payments, coupons, and billing information.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Refunds</h5>
                        <p class="mb-0">Cancellation rules, refund status, and ticket changes.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Baggage</h5>
                        <p class="mb-0">Limits, special items, and pet travel policies.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Account</h5>
                        <p class="mb-0">Password reset, security tips, and notifications.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Support</h5>
                        <p class="mb-0">Open a support request or reach live chat.</p>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h5>Contact</h5>
            <p class="mb-0">Email: support@hamsibus.com | Phone: 0850 000 00 00 | Hours: 09:00 - 22:00</p>
        </div>
    </div>
</div>