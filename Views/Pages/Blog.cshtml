@{
    ViewData["Title"] = "Blog";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Blog</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>HamsiBus Stories</h4>
            <p>Read tips, route guides, and updates from the HamsiBus team.</p>

            <div class="row g-3 mt-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Comfort Tips for Long Trips</h5>
                        <p class="mb-1">Simple habits that make a 6+ hour ride feel easier.</p>
                        <small class="text-muted">May 2026 • 6 min read</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Black Sea Spring Routes</h5>
                        <p class="mb-1">Top stops across Trabzon, Rize, and Artvin.</p>
                        <small class="text-muted">May 2026 • 5 min read</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Packing Checklist for Bus Travel</h5>
                        <p class="mb-1">Lightweight essentials for short and long trips.</p>
                        <small class="text-muted">Apr 2026 • 4 min read</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Best Times to Depart</h5>
                        <p class="mb-1">Plan around traffic and breaks to save time.</p>
                        <small class="text-muted">Apr 2026 • 3 min read</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>