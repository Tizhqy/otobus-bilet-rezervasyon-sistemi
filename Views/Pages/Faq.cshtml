@{
    ViewData["Title"] = "Frequently Asked Questions";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">Frequently Asked Questions</h1>
    <div class="card shadow-sm border-0 card-HamsiBus">
        <div class="card-body p-4">
            <h4>Common Questions</h4>
            <p>Find quick answers below. If you need more help, contact support.</p>

            <hr class="my-4" />

            <div class="mb-3">
                <h5>How do I buy a ticket?</h5>
                <p>Select a route and date, choose a seat, then complete payment to confirm the reservation.</p>
            </div>

            <div class="mb-3">
                <h5>Can I change or cancel a ticket?</h5>
                <p>Change and refund rules depend on the carrier. The applicable terms are shown during checkout.</p>
            </div>

            <div class="mb-3">
                <h5>Where can I find my e-ticket?</h5>
                <p>You can access it in My Account &gt; Tickets or via the email sent after purchase.</p>
            </div>

            <div class="mb-3">
                <h5>Do I need to print the ticket?</h5>
                <p>Most carriers accept mobile tickets, but please check the carrier rules shown on your ticket.</p>
            </div>

            <div class="mb-3">
                <h5>What is the baggage allowance?</h5>
                <p>Baggage limits vary by carrier and are listed in the trip details.</p>
            </div>

            <div class="mb-0">
                <h5>Can I travel with a pet?</h5>
                <p>Some carriers allow pets under specific conditions. Review the trip rules before booking.</p>
            </div>
        </div>
    </div>
</div>