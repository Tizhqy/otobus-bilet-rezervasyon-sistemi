@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5 pt-4">
    <h1 class="mb-4">About Us</h1>
    <div class="card shadow-sm border-0 card-HamsiBus mb-4">
        <div class="card-body p-4">
            <h4>Who We Are</h4>
            <p>HamsiBus is Turkey's most modern and user-friendly online bus ticket platform. We provide service on hundreds of routes as the address of comfortable and safe travel.</p>
            
            <h4 class="mt-4">Our Vision</h4>
            <p>To provide our passengers the most stress-free, reliable, and affordable formulas for transit from one point to another.</p>
            
            <h4 class="mt-4">Our Mission</h4>
            <p>To offer convenience to both our customers and business partners with high-security standards by updating our digital infrastructure day by day.</p>
        </div>
    </div>

    <h2 class="mb-4 mt-5">Our Team</h2>
    <div class="row">
        <!-- Team Member 1 -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 card-HamsiBus h-100 text-center">
                <div class="card-body p-4">
                    <div style="width:100px; height:100px; background-color:#e2e8f0; border-radius:50%; margin:0 auto 15px; display:flex; align-items:center; justify-content:center;">
                        <i data-lucide="user" style="color:#94a3b8; width:40px; height:40px;"></i>
                    </div>
                    <h5 class="card-title">Mehmet Eren Bayraktar</h5>
                    <p class="text-muted small mb-3">Backend/Frontend</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="#" class="btn btn-sm btn-outline-HamsiBus px-2 py-1"><i data-lucide="github" style="width:16px;"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-HamsiBus px-2 py-1"><i data-lucide="linkedin" style="width:16px;"></i></a>
                    </div>
                </div>
            </div>
        </div>
