@model TicketResponseDto
@{
	Layout = null;
	int remainingSeconds = ViewBag.KalanSaniye ?? 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Odeme</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
<div class="container py-4" style="max-width:760px;">
	<h1 class="h4 mb-4">Odeme</h1>

	@if (TempData["Hata"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}

	<div class="card-HamsiBus mb-4">
		<div class="card-body p-4">
			<div class="d-flex justify-content-between align-items-center mb-2">
				<div class="fw-700">Bilet #@Model.Id</div>
				<div class="badge text-bg-warning">Kalan Sure: <span id="countdown">@remainingSeconds</span> sn</div>
			</div>
			<div class="text-muted">@Model.Departure.OriginStation -> @Model.Departure.DestinationStation</div>
			<div class="text-muted">Kalkis: @Model.Departure.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
			<div class="fw-700 mt-2">Tutar: @Model.TotalPrice.ToString("0.00") TL</div>
		</div>
	</div>

	<div class="card-HamsiBus">
		<div class="card-body p-4">
			<form asp-controller="Odeme" asp-action="Tamamla" method="post" id="paymentForm">
				<input type="hidden" name="biletId" value="@Model.Id" />

				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Odeme Yontemi</label>
						<select name="odemeYontemi" class="form-select">
							<option value="credit_card">Kredi Karti</option>
							<option value="debit_card">Banka Karti</option>
						</select>
					</div>
					<div class="col-md-6">
						<label class="form-label">Kart Sahibi</label>
						<input name="kartSahibi" class="form-control" required />
					</div>
					<div class="col-md-6">
						<label class="form-label">Kart No</label>
						<input name="kartNo" class="form-control" maxlength="19" placeholder="0000 0000 0000 0000" required />
					</div>
					<div class="col-md-3">
						<label class="form-label">Son Kullanma</label>
						<input name="sonKullanma" class="form-control" placeholder="MM/YY" required />
					</div>
					<div class="col-md-3">
						<label class="form-label">CVV</label>
						<input name="cvv" class="form-control" maxlength="4" required />
					</div>
				</div>

				<div class="d-flex gap-2 mt-4">
					<button type="submit" class="btn btn-primary-HamsiBus">Odemeyi Tamamla</button>
					<a asp-controller="Bilet" asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-ghost">Vazgec</a>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	(function () {
		let seconds = @remainingSeconds;
		const countdownEl = document.getElementById('countdown');
		if (!countdownEl) return;

		const timer = setInterval(function () {
			seconds -= 1;
			countdownEl.textContent = String(Math.max(seconds, 0));
			if (seconds <= 0) {
				clearInterval(timer);
				window.location.href = '/Sefer/Index';
			}
		}, 1000);
	})();
</script>
</body>
</html>
